{
  "name": "mac-voice-workspace",
  "version": "0.2.1",
  "description": "拾序 · Mac 个人事务工作台",
  "main": "main.js",
  "author": "Muzi-Li",
  "license": "MIT",
  "scripts": {
    "test": "node scripts/test-desktop.js",
    "start": "electron .",
    "build": "electron-builder --mac dmg --publish never",
    "build:win": "electron-builder --win nsis --x64 --publish never",
    "build:zip": "electron-builder --mac zip",
    "pack": "electron-builder --dir",
    "build:native": "node scripts/build-native.js",
    "prepack": "npm run build:native",
    "prebuild": "npm run build:native",
    "prestart": "npm run build:native"
  },
  "devDependencies": {
    "electron": "^44.0.0",
    "electron-builder": "^26.15.7"
  },
  "build": {
    "appId": "com.personal.voiceworkspace",
    "productName": "拾序",
    "artifactName": "Shixu-${version}-${arch}.${ext}",
    "copyright": "© 2026 Muzi-Li; based on TO-DO Panel © xiaopu-ai",
    "asar": false,
    "electronLanguages": [
      "zh_CN",
      "zh-CN",
      "en",
      "en-US"
    ],
    "directories": {
      "output": "dist.noindex",
      "buildResources": "build"
    },
    "afterPack": "./build/afterPack.js",
    "files": [
      "main.js",
      "main-services.js",
      "platform.js",
      "build/shixu-icon.png",
      "main/**/*",
      "preload.js",
      "preload-island.js",
      "preload-permissions.js",
      "renderer/**/*",
      "scripts/codex-notify.js",
      "scripts/claude-notify.js",
      "scripts/claude-statusline.js",
      "package.json",
      "!**/node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!**/node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!**/node_modules/.bin",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "native/**/*",
      "third_party/**/*",
      "LICENSE"
    ],
    "mac": {
      "icon": "build/shixu-icon.icns",
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "darkModeSupport": true,
      "extendInfo": {
        "LSUIElement": true,
        "NSHighResolutionCapable": true,
        "CFBundleDisplayName": "拾序",
        "NSCameraUsageDescription": "拾序 需要使用摄像头来显示「镜子」预览。",
        "NSMicrophoneUsageDescription": "拾序 需要使用麦克风来录音并生成转写文本。",
        "NSAppleEventsUsageDescription": "拾序 需要控制「系统事件」来枚举并聚焦当前窗口，并控制音乐播放器的播放 / 切歌。",
        "NSCalendarsFullAccessUsageDescription": "读取日历检查空闲时间，并将确认的任务安排写入日历。",
        "NSCalendarsUsageDescription": "读取日历检查空闲时间，并将确认的任务安排写入日历。"
      }
    },
    "win": {
      "icon": "build/shixu-icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "TO-DO-Panel-${version}-windows-${arch}-setup.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": false
    },
    "dmg": {
      "title": "拾序 ${version}",
      "iconSize": 100,
      "contents": [
        {
          "x": 130,
          "y": 220
        },
        {
          "x": 410,
          "y": 220,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 540,
        "height": 380
      }
    }
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MUZI-LYY/shixu.git"
  },
  "homepage": "https://github.com/MUZI-LYY/shixu#readme",
  "bugs": {
    "url": "https://github.com/MUZI-LYY/shixu/issues"
  },
  "contributors": [
    "xiaopu-ai (TO-DO Panel upstream)"
  ]
}
